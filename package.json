{
  "name": "@lapismd/lapis-ci-source",
  "version": "0.0.0",
  "private": true,
  "description": "Deterministic multi-architecture CI toolchain images for LapisMD repositories.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "check": "node scripts/check-repository.mjs",
    "test": "node --test scripts/*.test.mjs",
    "verify": "pnpm check && pnpm test",
    "image:build": "docker buildx build --load --tag lapismd/lapis-ci:candidate .",
    "image:build:amd64": "docker buildx build --load --platform linux/amd64 --tag lapismd/lapis-ci:candidate-amd64 .",
    "image:build:arm64": "docker buildx build --load --platform linux/arm64 --tag lapismd/lapis-ci:candidate-arm64 .",
    "image:smoke": "docker run --rm lapismd/lapis-ci:candidate node /usr/local/share/lapis-ci/verify-image.mjs"
  }
}
